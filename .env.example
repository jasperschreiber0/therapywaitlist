DATABASE_URL=postgresql://user:password@localhost:5432/therapywaitlist

# Anthropic — get from console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Resend — get from resend.com (verify your domain first)
RESEND_API_KEY=re_...

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-32-byte-hex-secret-here

# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_API_KEY=your-admin-api-key-here

# URLs
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:4000
PORT=4000
NODE_ENV=development

# Where staleness alerts are sent
ADMIN_EMAIL=admin@therapywaitlist.com.au
